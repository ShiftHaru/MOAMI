<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.android.chrome" /><package android:name="com.twitter.android" /></queries>
    <!-- Only node-supplied image files are requested for previews, never page HTML. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@android:drawable/ic_menu_search"
        android:label="BrowserDownloader G1"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ResultsActivity" android:exported="false"
            android:theme="@style/ResultsPopup"
            android:taskAffinity="dev.browserdownloader.probe.results"
            android:excludeFromRecents="true" />
        <activity android:name=".CompareActivity" android:exported="false" />
        <activity android:name=".XActivity" android:exported="false" />
        <activity android:name=".XShareActivity" android:exported="false"
            android:theme="@style/ResultsPopup" android:launchMode="singleTask"
            android:taskAffinity="dev.browserdownloader.probe.xshare" android:excludeFromRecents="true" />
        <receiver android:name=".ScanNotification" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ShareActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="dev.browserdownloader.probe.share" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".ChromeProbeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/probe_service" />
        </service>
    </application>
</manifest>
